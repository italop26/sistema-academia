# Execute: node scripts/setup-env.mjs. Não use este arquivo como credencial.
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5174","http://127.0.0.1:5174"]
# Opcional: ativa SQLite. Sem DATABASE_URL, utiliza PostgreSQL.
# DATABASE_URL=sqlite+pysqlite:///./data/academia.db
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_MINUTES=15
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=academia
POSTGRES_USER=academia
POSTGRES_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
VITE_API_URL=/api
# Somente desenvolvimento/testes. Sem pagamento real; bloqueado em produção.
PIX_SIMULATOR_ENABLED=false
# Segredo exclusivo de testes, mínimo 32 caracteres. Nunca reutilizar o JWT.
# Deixe ausente até habilitar o webhook no ambiente isolado.
# PIX_WEBHOOK_TEST_SECRET=
# Automação somente simulada. Nenhuma mensagem real é enviada.
FINANCIAL_AUTOMATION_ENABLED=false
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_DISPATCH_LEASE_SECONDS=120
# Ausência: identificação interna após 240h; sem mensagens externas.
ABSENCE_TRACKING_ENABLED=false
ABSENCE_BATCH_SIZE=50
